# Runtime connection. For local development, both URLs can be identical.
# On Neon, use the pooled URL for DATABASE_URL and direct URL for DIRECT_URL.
DATABASE_URL="postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/myclick?schema=public"
DIRECT_URL="postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/myclick?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Optional: required only for sending password-reset emails.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
